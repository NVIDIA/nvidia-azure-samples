{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vmAdminPassword": {
      "type": "securestring"
    },
    "vmAdminUsername": {
      "type": "string"
    },
    "labInstanceId": {
      "type": "string"
    },
    "deployLabSetup": {
      "type": "bool",
      "defaultValue": true
    },
    "preinstallAgent": {
      "type": "bool",
      "defaultValue": false
    }
  }
}
