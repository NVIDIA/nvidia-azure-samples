# Direct notebook access to the IP-restricted cuOpt ACA endpoint.
CUOPT_BASE_URL=https://<cuopt-container-app-fqdn>
CUOPT_TIME_LIMIT_SECONDS=10
CUOPT_WAKE_TIMEOUT_SECONDS=720

# Azure Maps account used for direct notebook rendering. Authenticate with
# `az login`; never place an Azure Maps key or bearer token in this file.
AZURE_MAPS_CLIENT_ID=<azure-maps-account-client-id>

# Informational Azure asset identifiers used by the deployment walkthrough.
AZURE_SUBSCRIPTION_ID=<azure-subscription-id>
AZURE_TENANT_ID=<azure-tenant-id>
AZURE_RESOURCE_GROUP=<resource-group-name>
AZURE_LOCATION=<azure-region>
AZURE_CONTAINER_APP_NAME=<cuopt-container-app-name>
AZURE_CONTAINER_APPS_ENVIRONMENT=<container-apps-environment-name>
AZURE_MAPS_ACCOUNT_NAME=<azure-maps-account-name>
AZURE_CONTAINER_REGISTRY_NAME=<azure-container-registry-name>

# Optional FastAPI web-demo settings. Leave blank for local replay mode.
ALLOWED_PRINCIPAL_IDS=
# Local-only fallback; Azure uses managed identity. Do not commit a real token.
AZURE_MAPS_TOKEN=
