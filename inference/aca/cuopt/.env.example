# Local replay mode: leave CUOPT_BASE_URL empty.
CUOPT_BASE_URL=
CUOPT_WAKE_TIMEOUT_SECONDS=720
ALLOWED_PRINCIPAL_IDS=
AZURE_MAPS_CLIENT_ID=
# Local-only fallback. Azure uses managed identity instead.
AZURE_MAPS_TOKEN=
