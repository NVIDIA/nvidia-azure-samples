# ---------------------------------------------------------------------------
# vss-msbuild — example test-only environment configuration
# ---------------------------------------------------------------------------
# Copy to .env.test and fill in real values:    cp .env.test.example .env.test
# Loaded by demo/insurance-claims/tests/conftest.py on top of .env, so test
# vars here override anything in .env without polluting runtime config.
# ---------------------------------------------------------------------------

# --- demo/insurance-claims/ — local-runner E2E -----------------------------
# Drives local_runner.py against real VSS + real Azure OpenAI. Each run
# costs a few cents and takes ~5 minutes.
RUN_E2E_TESTS=1
TEST_VIDEO_PATH=/absolute/path/to/your/damage.mp4

# --- demo/insurance-claims-foundry/ — deployed-agent E2E -------------------
# Shells out to `azd ai agent invoke` (no --local) against the deployed
# Foundry agent. Independent gate so each suite can be enabled separately.
# Requires that `azd deploy` has been run successfully.
RUN_E2E_REMOTE_TESTS=1
# Set to insurance-claims-triage to test the mock hosted agent instead.
REMOTE_AGENT_NAME=insurance-claims-triage-vss
