# ---------------------------------------------------------------------------
# vss-msbuild — example environment configuration
# ---------------------------------------------------------------------------
# Copy to .env and fill in real values:    cp .env.example .env
# Then either: `source .env` for local runs, or feed into azd / App Service /
# Container Apps settings for cloud deployments.
# ---------------------------------------------------------------------------

# --- Azure subscription / infra (used by azd, bicep params, deploy docs) ---
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-your-project
AZURE_LOCATION=eastus
AZURE_AI_ACCOUNT_NAME=your-foundry-account
AZURE_AI_PROJECT_NAME=your-foundry-project

# --- Foundry project endpoint (read by demo/insurance-claims-foundry main.py)
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-account.services.ai.azure.com/api/projects/your-foundry-project

# --- Model deployment name --------------------------------------------------
# Read by both demos:
#   - demo/insurance-claims/local_runner.py
#   - demo/insurance-claims-foundry/.../main.py + agent.yaml + agent.manifest.yaml
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Azure OpenAI (local_runner.py) ----------------------------------------
# Endpoint is the Foundry account host (no /api/projects/... path).
AZURE_OPENAI_ENDPOINT=https://your-foundry-account.services.ai.azure.com
# AZURE_OPENAI_API_KEY=                # leave unset to use DefaultAzureCredential

# --- VSS backend (NVIDIA Video Search & Summarization) ---------------------
VSS_BASE_URL=http://vss.<EXTERNAL_HOST>.nip.io

# --- Foundry hosted-agent endpoint (read by demo/insurance-claims-ui/app.py)
# Populate after `azd deploy` creates the agent — full /agents/<name>/endpoint URL.
# FOUNDRY_AGENT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/agents/<agent-name>/endpoint/protocols/openai/responses?api-version=2025-11-15-preview

# --- Test config -----------------------------------------------------------
# Test-only knobs (RUN_E2E_TESTS, TEST_VIDEO_PATH) live in .env.test — see
# .env.test.example for the template.
